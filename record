import sounddevice as sd
import soundfile as sf

duration = 5
sample_rate = 16000

print("Recording...")

audio = sd.rec(
    int(duration * sample_rate),
    samplerate=sample_rate,
    channels=1,
    dtype="int16"
)

sd.wait()

sf.write("recording8.wav", audio, sample_rate)

print("Saved as recording.wav")
